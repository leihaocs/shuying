# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# 机器本地依赖覆盖（各机器一份，绝不入库）。
# Mac 把 shared_preferences 各平台实现指向了本机 fork 的绝对路径
# /Users/leihao/flutter_packages_ohos/...，这台 Windows 上不存在 → pub get 直接失败。
# 本机用它重定向到 pub.dev 同版本，只为跑 analyze / test；Mac 上没有此文件，不受影响。
/pubspec_overrides.yaml
/.ohos_stub/

# 依赖锁文件：两台机器解析结果不同（Mac 用本地 fork 路径，本机用 pub.dev），
# 共享一份 lock 只会来回冲突，且本机生成的 lock 会让 Mac 的鸿蒙构建解析错包。
# 各机器各自 pub get 生成，不入库。
/pubspec.lock

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android：机器相关的本地配置（sdk.dir 是绝对路径，Windows 与 macOS 不同）
# 不忽略的话，Mac 生成 android/ 提交后，Windows 拉下来路径对不上，构建会失败。
/android/local.properties
/android/.gradle/

# Widget Preview related
.widget_preview/

# Flutter SDK 版本标记（记录创建时的 Flutter SDK 版本，跨 Windows/macOS 会冲突；本项目按机器各自生成）
.metadata

# Windows 端专用执行清单（Mac 上无意义，本机专用，不入 git）
/docs/Windows执行清单.md

# ── 签名与密钥（绝不能提交，含密码/私钥）─────────────────────────
# Android：key.properties 里有 storePassword/keyPassword 明文
/android/key.properties
/android/*.jks
/android/*.keystore
*.jks
*.keystore

# iOS：证书、描述文件、Xcode 个人配置
/ios/Runner.xcworkspace/xcuserdata/
/ios/**/*.mobileprovision
/ios/**/*.p12
/ios/**/*.cer
/ios/Flutter/Generated.xcconfig
/ios/Podfile.lock

# HarmonyOS：签名证书与 Profile
/ohos/**/*.p12
/ohos/**/*.cer
/ohos/**/*.p7b
/ohos/**/signingConfigs.json
